generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// 01-identity.prisma
// ======================================================

// ======================================================
// Identity Domain
// ======================================================

enum UserRole {
  USER
  SUPPORT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum DeviceType {
  DESKTOP
  LAPTOP
  MOBILE
  TABLET
  SMART_TV
  UNKNOWN
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RevokedReason {
  USER_LOGOUT
  PASSWORD_CHANGED
  ADMIN_REVOKED
  SUSPICIOUS_ACTIVITY
  TOKEN_REUSE
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                  String     @id @default(uuid())
  userNumber          String     @unique
  email               String     @unique
  passwordHash        String
  role                UserRole   @default(USER)
  status              UserStatus @default(PENDING)
  emailVerified       Boolean    @default(false)
  phoneVerified       Boolean    @default(false)
  failedLoginAttempts Int        @default(0)

  lockedUntil DateTime?
  lastLoginAt DateTime?
  deletedAt   DateTime?

  profile             Profile?
  pendingRegistration PendingRegistration?
  sessions            Session[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  passwordChangedAt    DateTime?
  biometricCredentials BiometricCredential[]
  authTokens           AuthToken[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Profile {
  id               String    @id @default(uuid())
  profileNumber    String    @unique
  userId           String    @unique
  displayName      String
  legalName        String
  firstName        String
  middleName       String?
  lastName         String
  birthDate        DateTime?
  phoneCountryCode String?
  phoneNumber      String?
  avatarUrl        String?
  languageCode     String?
  languageId       String?

  language   Language? @relation(fields: [languageId], references: [id])
  timezoneId String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayName])
  @@index([legalName])
  @@map("profiles")
}

model Session {
  id                       String         @id @default(uuid())
  reference                String         @unique
  userId                   String
  refreshTokenHash         String
  previousRefreshTokenHash String?
  mfaVerifiedAt            DateTime?
  deviceName               String?
  deviceType               DeviceType     @default(UNKNOWN)
  operatingSystem          String?
  browser                  String?
  browserVersion           String?
  fingerprint              String?
  isTrusted                Boolean        @default(false)
  ipAddress                String?
  countryCode              String?
  city                     String?
  status                   SessionStatus  @default(ACTIVE)
  lastActivityAt           DateTime?
  expiresAt                DateTime
  revokedAt                DateTime?
  revokedReason            RevokedReason?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  biometricCredentials BiometricCredential[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([fingerprint])
  @@index([lastActivityAt])
  @@map("sessions")
}

model AuthToken {
  id     String        @id @default(uuid())
  userId String
  type   AuthTokenType

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model PendingRegistration {
  id String @id @default(uuid())

  userId String @unique

  firstName    String
  lastName     String
  countryCode  String
  phone        String
  languageCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode])
  @@map("pending_registrations")
}

// ======================================================
// biometric.prisma
// ======================================================

enum BiometricType {
  FINGERPRINT
  FACE
  IRIS
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  WINDOWS
  MACOS
  LINUX
}

model BiometricCredential {
  // ======================================================
  // Identity
  // ======================================================

  id              String @id @default(uuid())
  biometricNumber String @unique

  // ======================================================
  // Relationships
  // ======================================================

  userId    String
  sessionId String?

  // ======================================================
  // Device
  // ======================================================

  deviceId   String
  deviceName String?

  platform DevicePlatform

  // ======================================================
  // Credential
  // ======================================================

  biometricType BiometricType

  credentialId String @unique
  publicKey    String

  signCount Int @default(0)

  // ======================================================
  // Status
  // ======================================================

  isEnabled Boolean @default(true)

  isPrimary Boolean @default(false)

  verifiedAt DateTime?

  lastUsedAt DateTime?

  revokedAt DateTime?

  revokedReason String?

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ======================================================
  // Relations
  // ======================================================

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  session Session? @relation(fields: [sessionId], references: [id])

  // ======================================================
  // Indexes
  // ======================================================

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([platform])
  @@index([isEnabled])
  @@index([lastUsedAt])
  @@map("biometric_credentials")
}

// ======================================================
// 02-localization.prisma
// ======================================================

model Country {
  id                String  @id @default(uuid())
  countryNumber     String  @unique
  iso2Code          String  @unique
  iso3Code          String  @unique
  numericCode       String?
  name              String
  officialName      String?
  flagEmoji         String?
  phoneCode         String
  postalCodeLabel   String
  postalCodePattern String?
  isActive          Boolean @default(true)

  accounts            Account[]
  complianceDocuments ComplianceDocument[]
  countryCurrencies   CountryCurrency[]
  countryLanguages    CountryLanguage[]
  countryTimezones    CountryTimezone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([iso2Code])
  @@map("countries")
}

model Currency {
  id             String  @id @default(uuid())
  currencyNumber String  @unique
  code           String  @unique
  name           String
  symbol         String
  decimals       Int     @default(2)
  isActive       Boolean @default(true)

  accounts           Account[]
  countryCurrencies  CountryCurrency[]
  exchangeRatesBase  ExchangeRate[]    @relation("BaseCurrency")
  exchangeRatesQuote ExchangeRate[]    @relation("QuoteCurrency")
  fees               Fee[]
  ledgerEntries      LedgerEntry[]
  transactions       Transaction[]
  wallets            Wallet[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  merchantSettings MerchantSettings[]

  @@index([code])
  @@map("currencies")
}

model Language {
  id             String  @id @default(uuid())
  languageNumber String  @unique
  code           String  @unique
  name           String
  nativeName     String
  isActive       Boolean @default(true)

  accounts         Account[]
  countryLanguages CountryLanguage[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  profiles         Profile[]
  merchantSettings MerchantSettings[]

  @@map("languages")
}

model Timezone {
  id             String @id @default(uuid())
  timezoneNumber String @unique
  name           String @unique
  utcOffset      String

  accounts         Account[]
  countryTimezones CountryTimezone[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  merchantSettings MerchantSettings[]

  @@map("timezones")
}

model CountryCurrency {
  countryId  String
  currencyId String
  isDefault  Boolean @default(false)

  country  Country  @relation(fields: [countryId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])

  @@id([countryId, currencyId])
  @@map("country_currencies")
}

model CountryLanguage {
  countryId  String
  languageId String
  isOfficial Boolean @default(true)

  country  Country  @relation(fields: [countryId], references: [id])
  language Language @relation(fields: [languageId], references: [id])

  @@id([countryId, languageId])
  @@map("country_languages")
}

model CountryTimezone {
  countryId  String
  timezoneId String
  isDefault  Boolean @default(false)

  country  Country  @relation(fields: [countryId], references: [id])
  timezone Timezone @relation(fields: [timezoneId], references: [id])

  @@id([countryId, timezoneId])
  @@map("country_timezones")
}

// ======================================================
// 03-accounts.prisma
// ======================================================

enum AccountCategory {
  PERSONAL
  BUSINESS
  MERCHANT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

model Account {
  id             String          @id @default(uuid())
  accountNumber  String          @unique
  profileId      String
  category       AccountCategory
  status         AccountStatus   @default(PENDING)
  displayName    String
  legalName      String?
  countryId      String
  languageId     String?
  timezoneId     String?
  baseCurrencyId String
  isDefault      Boolean         @default(false)

  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  country      Country   @relation(fields: [countryId], references: [id])
  language     Language? @relation(fields: [languageId], references: [id])
  timezone     Timezone? @relation(fields: [timezoneId], references: [id])
  baseCurrency Currency  @relation(fields: [baseCurrencyId], references: [id])

  wallets                 Wallet[]
  payments                Payment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  merchant                Merchant?
  complianceProfile       ComplianceProfile?
  recipientOwner          Recipient[]              @relation("OwnerRecipients")
  recipientDestination    Recipient[]              @relation("DestinationRecipients")
  exchangeQuotes          ExchangeQuote[]
  merchantMembers         MerchantMember[]         @relation("MerchantMemberAccount")

  merchantInvitations MerchantMember[]   @relation("MerchantInvitation")
  complianceReviews   ComplianceReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([countryId])
  @@index([status])
  @@index([category])
  @@index([baseCurrencyId])
  @@index([languageId])
  @@index([timezoneId])
  @@map("accounts")
}

// ======================================================
// 04-wallets.prisma
// ======================================================

enum WalletStatus {
  PENDING
  ACTIVE
  BLOCKED
  CLOSED
}

model Wallet {
  id               String       @id @default(uuid())
  walletNumber     String       @unique
  accountId        String
  currencyId       String
  status           WalletStatus @default(ACTIVE)
  isDefault        Boolean      @default(false)
  availableBalance Decimal      @default(0) @db.Decimal(20, 8)
  reservedBalance  Decimal      @default(0) @db.Decimal(20, 8)
  totalBalance     Decimal      @default(0) @db.Decimal(20, 8)

  account            Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency           Currency        @relation(fields: [currencyId], references: [id])
  ledgerEntries      LedgerEntry[]
  transactionsSource Transaction[]   @relation("SourceWallet")
  transactionsDest   Transaction[]   @relation("DestinationWallet")
  exchangeSource     Exchange[]      @relation("ExchangeSourceWallet")
  exchangeDest       Exchange[]      @relation("ExchangeDestinationWallet")
  quoteSource        ExchangeQuote[] @relation("QuoteSourceWallet")
  quoteDest          ExchangeQuote[] @relation("QuoteDestinationWallet")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, currencyId])
  @@index([accountId])
  @@index([currencyId])
  @@map("wallets")
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

model LedgerEntry {
  id            String          @id @default(uuid())
  entryNumber   String          @unique
  walletId      String
  transactionId String
  currencyId    String
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(20, 8)
  balanceAfter  Decimal         @db.Decimal(20, 8)
  description   String?

  wallet      Wallet      @relation(fields: [walletId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])
  currency    Currency    @relation(fields: [currencyId], references: [id])

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([transactionId])
  @@index([currencyId])
  @@map("ledger_entries")
}

// ======================================================
// 05-transactions.prisma
// ======================================================

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  EXCHANGE
  PAYMENT
  REFUND
  FEE
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

model Transaction {
  id                  String            @id @default(uuid())
  transactionNumber   String            @unique
  sourceWalletId      String?
  destinationWalletId String?
  currencyId          String
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  amount              Decimal           @db.Decimal(20, 8)
  feeAmount           Decimal           @default(0) @db.Decimal(20, 8)
  netAmount           Decimal           @db.Decimal(20, 8)
  description         String?
  externalReference   String?
  idempotencyKey      String?           @unique
  completedAt         DateTime?

  sourceWallet      Wallet?       @relation("SourceWallet", fields: [sourceWalletId], references: [id])
  destinationWallet Wallet?       @relation("DestinationWallet", fields: [destinationWalletId], references: [id])
  currency          Currency      @relation(fields: [currencyId], references: [id])
  ledgerEntries     LedgerEntry[]
  fees              Fee[]
  exchange          Exchange?
  payment           Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceWalletId])
  @@index([destinationWalletId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

model Fee {
  id            String  @id @default(uuid())
  feeNumber     String  @unique
  transactionId String
  name          String
  amount        Decimal @db.Decimal(20, 8)
  currencyId    String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  currency    Currency    @relation(fields: [currencyId], references: [id])

  createdAt DateTime @default(now())

  @@map("fees")
}

// ======================================================
// 06-recipients.prisma
// ======================================================

enum RecipientType {
  PERSONAL
  BUSINESS
  MERCHANT
}

enum RecipientStatus {
  ACTIVE
  BLOCKED
}

model Recipient {
  id                   String          @id @default(uuid())
  recipientNumber      String          @unique
  ownerAccountId       String
  destinationAccountId String
  displayName          String
  accountNumber        String
  type                 RecipientType
  status               RecipientStatus @default(ACTIVE)
  nickname             String?
  avatarUrl            String?

  ownerAccount       Account @relation("OwnerRecipients", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  destinationAccount Account @relation("DestinationRecipients", fields: [destinationAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerAccountId, destinationAccountId])
  @@index([ownerAccountId])
  @@index([destinationAccountId])
  @@map("recipients")
}

// ======================================================
// 07-exchange.prisma
// ======================================================

enum ExchangeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExchangeRateProvider {
  INTERNAL
  MANUAL
  ECB
  FIXER
  OPEN_EXCHANGE
  CUSTOM
}

enum ExchangeQuoteStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  CANCELLED
}

model ExchangeRate {
  id              String               @id @default(uuid())
  rateNumber      String               @unique
  baseCurrencyId  String
  quoteCurrencyId String
  rate            Decimal              @db.Decimal(20, 10)
  provider        ExchangeRateProvider
  validFrom       DateTime
  validUntil      DateTime?

  baseCurrency  Currency        @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])
  quoteCurrency Currency        @relation("QuoteCurrency", fields: [quoteCurrencyId], references: [id])
  exchanges     Exchange[]
  quotes        ExchangeQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseCurrencyId])
  @@index([quoteCurrencyId])
  @@map("exchange_rates")
}

model Exchange {
  id                  String         @id @default(uuid())
  exchangeNumber      String         @unique
  transactionId       String         @unique
  exchangeRateId      String
  quoteId             String         @unique
  sourceWalletId      String
  destinationWalletId String
  sourceAmount        Decimal        @db.Decimal(20, 8)
  destinationAmount   Decimal        @db.Decimal(20, 8)
  exchangeFee         Decimal        @default(0) @db.Decimal(20, 8)
  status              ExchangeStatus @default(PENDING)
  completedAt         DateTime?

  transaction       Transaction   @relation(fields: [transactionId], references: [id])
  exchangeRate      ExchangeRate  @relation(fields: [exchangeRateId], references: [id])
  sourceWallet      Wallet        @relation("ExchangeSourceWallet", fields: [sourceWalletId], references: [id])
  destinationWallet Wallet        @relation("ExchangeDestinationWallet", fields: [destinationWalletId], references: [id])
  quote             ExchangeQuote @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([exchangeRateId])
  @@index([quoteId])
  @@index([sourceWalletId])
  @@index([destinationWalletId])
  @@index([status])
  @@map("exchanges")
}

model ExchangeQuote {
  id                  String              @id @default(uuid())
  quoteNumber         String              @unique
  accountId           String
  exchangeRateId      String
  sourceWalletId      String
  destinationWalletId String
  sourceAmount        Decimal             @db.Decimal(20, 8)
  destinationAmount   Decimal             @db.Decimal(20, 8)
  exchangeFee         Decimal             @default(0) @db.Decimal(20, 8)
  status              ExchangeQuoteStatus @default(ACTIVE)
  expiresAt           DateTime
  acceptedAt          DateTime?

  account           Account      @relation(fields: [accountId], references: [id])
  exchangeRate      ExchangeRate @relation(fields: [exchangeRateId], references: [id])
  sourceWallet      Wallet       @relation("QuoteSourceWallet", fields: [sourceWalletId], references: [id])
  destinationWallet Wallet       @relation("QuoteDestinationWallet", fields: [destinationWalletId], references: [id])
  exchange          Exchange?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([exchangeRateId])
  @@index([sourceWalletId])
  @@index([destinationWalletId])
  @@index([status])
  @@index([expiresAt])
  @@map("exchange_quotes")
}

// ======================================================
// 08-payments.prisma
// ======================================================

enum PaymentMethod {
  WALLET
  BANK_TRANSFER
  CARD
  PIX
  QR_CODE
  PAYMENT_LINK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  PURCHASE
  BILL_PAYMENT
  QR_PAYMENT
  PAYMENT_LINK
  SUBSCRIPTION
  DONATION
}

model Payment {
  id                String        @id @default(uuid())
  paymentNumber     String        @unique
  accountId         String
  transactionId     String        @unique
  merchantId        String?
  type              PaymentType
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  description       String?
  externalReference String?
  amount            Decimal       @db.Decimal(20, 8)
  feeAmount         Decimal       @default(0) @db.Decimal(20, 8)
  totalAmount       Decimal       @db.Decimal(20, 8)
  completedAt       DateTime?
  cancelledAt       DateTime?

  account     Account     @relation(fields: [accountId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])
  merchant    Merchant?   @relation(fields: [merchantId], references: [id])
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([transactionId])
  @@index([merchantId])
  @@index([status])
  @@index([type])
  @@map("payments")
}

enum InvoiceStatus {
  OPEN
  PAID
  CANCELLED
  EXPIRED
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  paymentId     String
  status        InvoiceStatus @default(OPEN)
  amount        Decimal       @db.Decimal(20, 8)
  dueDate       DateTime
  paidAt        DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

// ======================================================
// 09-notifications.prisma
// ======================================================

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationType {
  SECURITY
  PAYMENT
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  EXCHANGE
  LOGIN
  MFA
  KYC
  SYSTEM
  MARKETING
}

model Notification {
  id                 String               @id @default(uuid())
  notificationNumber String               @unique
  accountId          String
  templateId         String?
  providerId         String?
  providerReference  String?
  type               NotificationType
  channel            NotificationChannel
  status             NotificationStatus   @default(PENDING)
  priority           NotificationPriority @default(NORMAL)
  subject            String?
  title              String
  message            String
  scheduledAt        DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?

  account  Account               @relation(fields: [accountId], references: [id])
  template NotificationTemplate? @relation(fields: [templateId], references: [id])
  provider NotificationProvider? @relation(fields: [providerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([templateId])
  @@index([providerId])
  @@index([status])
  @@index([priority])
  @@index([channel])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  notificationTemplateNumber String @unique

  // ======================================================
  // Template
  // ======================================================

  name String

  type NotificationType

  channel NotificationChannel

  subject String?

  title String

  body String

  isActive Boolean @default(true)

  // ======================================================
  // Relationships
  // ======================================================

  notifications Notification[]

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([channel])
  @@index([isActive])
  @@map("notification_templates")
}

model NotificationPreference {
  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  notificationPreferenceNumber String @unique

  // ======================================================
  // Relationships
  // ======================================================

  accountId String

  // ======================================================
  // Preferences
  // ======================================================

  type NotificationType

  emailEnabled Boolean @default(true)

  smsEnabled Boolean @default(false)

  pushEnabled Boolean @default(true)

  inAppEnabled Boolean @default(true)

  whatsappEnabled Boolean @default(true)

  // ======================================================
  // Relationships
  // ======================================================

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([accountId, type])
  @@index([accountId])
  @@index([type])
  @@map("notification_preferences")
}

enum NotificationProviderType {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

model NotificationProvider {
  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  notificationProviderNumber String @unique

  // ======================================================
  // Provider
  // ======================================================

  name String

  type NotificationProviderType

  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  configuration Json?

  // ======================================================
  // Relationships
  // ======================================================

  notifications Notification[]

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
  @@map("notification_providers")
}

// ======================================================
// 10-merchant.prisma
// ======================================================

enum MerchantType {
  INDIVIDUAL
  COMPANY
  NON_PROFIT
  GOVERNMENT
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
}

model Merchant {
  id             String         @id @default(uuid())
  merchantNumber String         @unique
  accountId      String
  legalName      String
  tradeName      String?
  merchantType   MerchantType
  status         MerchantStatus @default(PENDING)
  website        String?
  supportEmail   String?
  supportPhone   String?

  account Account @relation(fields: [accountId], references: [id])

  members MerchantMember[]

  settings MerchantSettings?
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId])
  @@index([status])
  @@index([merchantType])
  @@index([accountId])
  @@map("merchants")
}

enum MerchantRole {
  OWNER
  ADMIN
  MANAGER
  FINANCE
  OPERATOR
  CASHIER
  SUPPORT
  VIEWER
}

model MerchantMember {
  id                   String       @id @default(uuid())
  merchantMemberNumber String       @unique
  merchantId           String
  accountId            String
  role                 MerchantRole
  isActive             Boolean      @default(true)
  joinedAt             DateTime     @default(now())
  invitedByAccountId   String?

  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  account   Account  @relation("MerchantMemberAccount", fields: [accountId], references: [id])
  invitedBy Account? @relation("MerchantInvitation", fields: [invitedByAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, accountId])
  @@index([merchantId])
  @@index([accountId])
  @@index([role])
  @@index([isActive])
  @@index([joinedAt])
  @@map("merchant_members")
}

model MerchantSettings {
  id String @id @default(uuid())

  merchantSettingsNumber String @unique

  merchantId String @unique

  displayName String?

  logoUrl String?

  websiteUrl String?

  supportEmail String?

  supportPhone String?

  languageId String?

  timezoneId String?

  currencyId String?

  allowWalletPayments Boolean @default(true)

  allowQrCodePayments Boolean @default(true)

  allowPaymentLinks Boolean @default(true)

  autoSettlement Boolean @default(false)

  emailNotifications Boolean @default(true)

  smsNotifications Boolean @default(false)

  pushNotifications Boolean @default(true)

  whatsappNotifications Boolean @default(true)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  language Language? @relation(fields: [languageId], references: [id])

  timezone Timezone? @relation(fields: [timezoneId], references: [id])

  currency Currency? @relation(fields: [currencyId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([languageId])
  @@index([timezoneId])
  @@index([currencyId])
  @@map("merchant_settings")
}

// ======================================================
// 11-compliance.prisma
// ======================================================

enum VerificationLevel {
  NONE
  BASIC
  STANDARD
  ENHANCED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ComplianceProfile {
  id                      String             @id @default(uuid())
  complianceProfileNumber String             @unique
  accountId               String             @unique
  verificationLevel       VerificationLevel  @default(NONE)
  verificationStatus      VerificationStatus @default(PENDING)
  riskLevel               RiskLevel          @default(LOW)
  verifiedAt              DateTime?
  expiresAt               DateTime?

  account   Account              @relation(fields: [accountId], references: [id])
  documents ComplianceDocument[]
  reviews   ComplianceReview[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastReviewAt DateTime?

  @@index([verificationStatus])
  @@index([riskLevel])
  @@index([accountId])
  @@map("compliance_profiles")
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  TAX_ID
  BUSINESS_REGISTRATION
  PROOF_OF_ADDRESS
  SELFIE
  OTHER
}

enum ComplianceDocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model ComplianceDocument {
  id                       String @id @default(uuid())
  complianceDocumentNumber String @unique

  complianceProfileId String
  type                DocumentType
  countryId           String
  documentIdentifier  String
  issuingAuthority    String?
  issuedAt            DateTime?
  expiresAt           DateTime?
  fileHash            String?
  frontImageUrl       String?
  backImageUrl        String?
  selfieImageUrl      String?
  status              ComplianceDocumentStatus @default(PENDING)
  verifiedAt          DateTime?
  rejectionReason     String?

  complianceProfile ComplianceProfile @relation(fields: [complianceProfileId], references: [id], onDelete: Cascade)
  country           Country           @relation(fields: [countryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complianceProfileId])
  @@index([status])
  @@index([type])
  @@index([countryId])
  @@index([verifiedAt])
  @@map("compliance_documents")
}

enum ComplianceDecision {
  APPROVED
  REJECTED
  MANUAL_REVIEW
}

model ComplianceReview {
  id                     String             @id @default(uuid())
  complianceReviewNumber String             @unique
  complianceProfileId    String
  reviewedByAccountId    String?
  reviewDuration         Int?
  decision               ComplianceDecision

  notes      String?
  riskScore  Int?
  reviewedAt DateTime?

  complianceProfile ComplianceProfile @relation(fields: [complianceProfileId], references: [id], onDelete: Cascade)
  reviewedBy        Account?          @relation(fields: [reviewedByAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complianceProfileId])
  @@index([decision])
  @@index([reviewedAt])
  @@map("compliance_reviews")
}
