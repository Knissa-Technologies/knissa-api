enum PaymentMethod {
  WALLET
  BANK_TRANSFER
  CARD
  PIX
  QR_CODE
  PAYMENT_LINK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  PURCHASE
  BILL_PAYMENT
  QR_PAYMENT
  PAYMENT_LINK
  SUBSCRIPTION
  DONATION
}

model Payment {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  // ======================================================
  // Relationships
  // ======================================================

  accountId String

  transactionId String

  merchantId String?

  // ======================================================
  // Business
  // ======================================================

  type PaymentType

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  description String?

  externalReference String?

  // ======================================================
  // Financial
  // ======================================================

  amount Decimal @db.Decimal(20,8)

  feeAmount Decimal @default(0) @db.Decimal(20,8)

  totalAmount Decimal @db.Decimal(20,8)

  // ======================================================
  // Dates
  // ======================================================

  completedAt DateTime?

  cancelledAt DateTime?

  // ======================================================
  // Relationships
  // ======================================================

  account Account @relation(
    fields: [accountId],
    references: [id]
  )

  transaction Transaction @relation(
    fields: [transactionId],
    references: [id]
  )

  merchant Merchant? @relation(
    fields: [merchantId],
    references: [id]
  )

  invoices Invoice[]

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([accountId])

  @@index([transactionId])

  @@index([merchantId])

  @@index([status])

  @@index([type])

  @@map("payments")

}

enum InvoiceStatus {
  OPEN
  PAID
  CANCELLED
  EXPIRED
}

model Invoice {

  id String @id @default(uuid())

  reference String @unique

  paymentId String

  status InvoiceStatus @default(OPEN)

  amount Decimal @db.Decimal(20,8)

  dueDate DateTime

  paidAt DateTime?

  payment Payment @relation(
    fields: [paymentId],
    references: [id]
  )

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([paymentId])

  @@index([status])

  @@index([dueDate])

  @@map("invoices")

}