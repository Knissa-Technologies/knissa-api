// ======================================================
// Identity Domain
// ======================================================

enum UserRole {
  USER
  SUPPORT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum DeviceType {
  DESKTOP
  LAPTOP
  MOBILE
  TABLET
  SMART_TV
  UNKNOWN
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RevokedReason {
  USER_LOGOUT
  PASSWORD_CHANGED
  ADMIN_REVOKED
  SUSPICIOUS_ACTIVITY
  TOKEN_REUSE
}

model User {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  // ======================================================
  // Authentication
  // ======================================================

  email String @unique

  passwordHash String

  // ======================================================
  // Authorization
  // ======================================================

  role UserRole @default(USER)

  status UserStatus @default(PENDING)

  // ======================================================
  // Verification
  // ======================================================

  emailVerified Boolean @default(false)

  phoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  deletedAt DateTime?

  // ======================================================
  // Relationships
  // ======================================================

  profile Profile?

  sessions Session[]

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([email])

  @@index([status])

  @@map("users")
}

model Profile {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  userId String @unique

  // ======================================================
  // Personal Information
  // ======================================================

  displayName String

  legalName String

  firstName String

  middleName String?

  lastName String

  birthDate DateTime?

  // ======================================================
  // Contact
  // ======================================================

  phoneCountryCode String?

  phoneNumber String?

  avatarUrl String?

  // ======================================================
  // Localization
  // ======================================================

  languageCode String?

  timezoneId String?

  // ======================================================
  // Relationships
  // ======================================================

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  accounts Account[]

  addresses Address[]

  userPreferences UserPreference?

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([displayName])

  @@index([legalName])

  @@map("profiles")
}

model Session {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  userId String

  // ======================================================
  // Authentication
  // ======================================================

  refreshTokenHash String

  mfaVerifiedAt DateTime?

  // ======================================================
  // Device
  // ======================================================

  deviceName String?

  deviceType DeviceType @default(UNKNOWN)

  operatingSystem String?

  browser String?

  browserVersion String?

  fingerprint String?

  isTrusted Boolean @default(false)

  // ======================================================
  // Network
  // ======================================================

  ipAddress String?

  countryCode String?

  city String?

  // ======================================================
  // Lifecycle
  // ======================================================

  status SessionStatus @default(ACTIVE)

  lastActivityAt DateTime?

  expiresAt DateTime

  revokedAt DateTime?

  revokedReason RevokedReason?

  // ======================================================
  // Relationships
  // ======================================================

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])

  @@index([status])

  @@index([expiresAt])

  @@index([fingerprint])

  @@index([lastActivityAt])

  @@map("sessions")
}