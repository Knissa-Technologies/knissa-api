// ======================================================
// Merchant Domain
// ======================================================

enum MerchantType {
  INDIVIDUAL
  COMPANY
  NON_PROFIT
  GOVERNMENT
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  CLOSED
}

enum MerchantRole {
  OWNER
  ADMIN
  MANAGER
  FINANCE
  OPERATOR
  CASHIER
  SUPPORT
  VIEWER
}

model Merchant {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  // ======================================================
  // Account
  // ======================================================

  accountId String

  // ======================================================
  // Business
  // ======================================================

  legalName String

  tradeName String?

  merchantType MerchantType

  status MerchantStatus @default(PENDING)

  website String?

  supportEmail String?

  supportPhone String?

  // ======================================================
  // Relationships
  // ======================================================

  account Account @relation(
    fields: [accountId],
    references: [id]
  )

  members MerchantMember[]

  settings MerchantSettings?

  payments Payment[]

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([accountId])

  @@index([accountId])

  @@index([status])

  @@index([merchantType])

  @@map("merchants")
}

model MerchantMember {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  // ======================================================
  // Relationships
  // ======================================================

  merchantId String

  accountId String

  invitedByAccountId String?

  // ======================================================
  // Membership
  // ======================================================

  role MerchantRole

  isActive Boolean @default(true)

  joinedAt DateTime @default(now())

  // ======================================================
  // Relationships
  // ======================================================

  merchant Merchant @relation(
    fields: [merchantId],
    references: [id],
    onDelete: Cascade
  )

  account Account @relation(
    "MerchantMemberAccount",
    fields: [accountId],
    references: [id]
  )

  invitedBy Account? @relation(
    "MerchantInvitation",
    fields: [invitedByAccountId],
    references: [id]
  )

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([merchantId, accountId])

  @@index([merchantId])

  @@index([accountId])

  @@index([role])

  @@map("merchant_members")
}

model MerchantSettings {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  merchantId String @unique

  // ======================================================
  // Business Settings
  // ======================================================

  displayName String?

  logoUrl String?

  websiteUrl String?

  supportEmail String?

  supportPhone String?

  // ======================================================
  // Localization
  // ======================================================

  languageCode String?

  timezoneId String?

  currencyCode String?

  // ======================================================
  // Payments
  // ======================================================

  allowWalletPayments Boolean @default(true)

  allowQrCodePayments Boolean @default(true)

  allowPaymentLinks Boolean @default(true)

  autoSettlement Boolean @default(false)

  // ======================================================
  // Notifications
  // ======================================================

  emailNotifications Boolean @default(true)

  smsNotifications Boolean @default(false)

  pushNotifications Boolean @default(true)

  whatsappNotifications Boolean @default(true)

  // ======================================================
  // Relationships
  // ======================================================

  merchant Merchant @relation(
    fields: [merchantId],
    references: [id],
    onDelete: Cascade
  )

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("merchant_settings")
}

// ======================================================
// Compliance Domain
// ======================================================

enum VerificationLevel {
  NONE
  BASIC
  STANDARD
  ENHANCED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  TAX_ID
  BUSINESS_REGISTRATION
  PROOF_OF_ADDRESS
  SELFIE
  OTHER
}

enum ComplianceDocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ComplianceDecision {
  APPROVED
  REJECTED
  MANUAL_REVIEW
}

model ComplianceProfile {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  // ======================================================
  // Owner
  // ======================================================

  accountId String @unique

  // ======================================================
  // Verification
  // ======================================================

  verificationLevel VerificationLevel @default(NONE)

  verificationStatus VerificationStatus @default(PENDING)

  riskLevel RiskLevel @default(LOW)

  // ======================================================
  // Dates
  // ======================================================

  verifiedAt DateTime?

  expiresAt DateTime?

  // ======================================================
  // Relationships
  // ======================================================

  account Account @relation(
    fields: [accountId],
    references: [id]
  )

  documents ComplianceDocument[]

  reviews ComplianceReview[]

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([verificationStatus])

  @@index([riskLevel])

  @@map("compliance_profiles")
}

model ComplianceDocument {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  complianceProfileId String

  // ======================================================
  // Document
  // ======================================================

  type DocumentType

  countryId String

  documentIdentifier String

  issuingAuthority String?

  issuedAt DateTime?

  expiresAt DateTime?

  // ======================================================
  // File
  // ======================================================

  frontImageUrl String?

  backImageUrl String?

  selfieImageUrl String?

  // ======================================================
  // Verification
  // ======================================================

  status ComplianceDocumentStatus @default(PENDING)

  verifiedAt DateTime?

  rejectionReason String?

  // ======================================================
  // Relationships
  // ======================================================

  complianceProfile ComplianceProfile @relation(
    fields: [complianceProfileId],
    references: [id],
    onDelete: Cascade
  )

  country Country @relation(
    fields: [countryId],
    references: [id]
  )

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([complianceProfileId])

  @@index([status])

  @@index([type])

  @@index([countryId])

  @@map("compliance_documents")
}

model ComplianceReview {

  // ======================================================
  // Identity
  // ======================================================

  id String @id @default(uuid())

  reference String @unique

  // ======================================================
  // Relationships
  // ======================================================

  complianceProfileId String

  reviewedByAccountId String?

  // ======================================================
  // Decision
  // ======================================================

  decision ComplianceDecision

  notes String?

  riskScore Int?

  // ======================================================
  // Dates
  // ======================================================

  reviewedAt DateTime?

  // ======================================================
  // Relationships
  // ======================================================

  complianceProfile ComplianceProfile @relation(
    fields: [complianceProfileId],
    references: [id],
    onDelete: Cascade
  )

  reviewedBy Account? @relation(
    fields: [reviewedByAccountId],
    references: [id]
  )

  // ======================================================
  // Audit
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([complianceProfileId])

  @@index([reviewedByAccountId])

  @@index([decision])

  @@map("compliance_reviews")
}