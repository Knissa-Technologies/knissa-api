{
  "name": "knissa-api",
  "version": "1.0.0",
  "description": "Backend API for the Knissa digital financial platform.",
  "private": false,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run docs:lint && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:docker": "docker compose exec api npm run seed",
    "docs:lint": "redocly lint docs/openapi/openapi.yaml",
    "docs:build": "redocly bundle docs/openapi/openapi.yaml -o docs/openapi/dist/openapi.yaml",
    "docs:preview": "redocly preview-docs docs/openapi/openapi.yaml",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Knissa-Technologies/knissa-api.git"
  },
  "keywords": [
    "knissa",
    "fintech",
    "api",
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "postgresql",
    "wallet",
    "payments",
    "exchange"
  ],
  "author": "Knissa Technologies",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Knissa-Technologies/knissa-api/issues"
  },
  "homepage": "https://github.com/Knissa-Technologies/knissa-api#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "argon2": "^0.45.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.1.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^2.40.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "express-list-endpoints": "^7.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
